# syntax = docker/dockerfile:1
#
# Native AOT variant of the C# production image. Same as the main Dockerfile but published
# with PublishAot=true, producing a fully native binary with no JIT, minimal memory footprint,
# and the fastest possible cold start. Requires AOT-compatible code (no reflection, source-gen
# JSON, invariant globalization).
#
#   docker build -t campfire-csharp:aot -f bench/runtimes/Dockerfile.aot .
#   docker tag campfire-csharp:aot campfire-csharp:app  # for bench/bin/run with CSHARP_IMAGE

ARG DOTNET_SDK_VERSION=10.0
ARG DEBIAN_RELEASE=trixie


# Restore, publish and build the frontend with the SDK, for the target architecture.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_VERSION} AS build
ARG TARGETARCH
ARG SOURCE_DATE_EPOCH
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src src

# Campfire.Templates.Generator is a Roslyn source generator targeting netstandard2.0, which
# does not support AOT. Since it is only used at build time (ReferenceOutputAssembly=false,
# OutputItemType=Analyzer), change its TFM to net10.0 so the AOT publish won't reject it.
# The compiler host runs on .NET 10 and can load net10.0 analyzers.
RUN sed -i 's|netstandard2.0|net10.0|' \
      src/Campfire.Templates.Generator/Campfire.Templates.Generator.csproj
RUN --mount=type=cache,target=/root/.nuget/packages \
    rid=linux-$([ "$TARGETARCH" = arm64 ] && echo arm64 || echo x64) && \
    dotnet publish src/Campfire.Server/Campfire.Server.csproj -c Release -r "$rid" \
      -p:DebugType=none -p:PublishAot=true -o /out/app && \
    rm -f /out/app/*.xml

# bin/build-assets: assets:precompile without Ruby or Node (assets/README.md). SOURCE_DATE_EPOCH,
# when given, makes every file's last-modified reproducible.
#
# NOTE: assets/build-assets.cs is a dotnet-script project. For AOT we build this as a separate
# JIT-published helper; the AOT publish above only covers the server binary.
COPY assets assets
COPY reference reference
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet run assets/build-assets.cs -- /src /out/app/assets


# Thruster from the gem reference/Gemfile.lock pins, for the target architecture, checked against
# rubygems.org's checksums (src/Campfire.Server/Front/).
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_VERSION} AS thruster
ARG TARGETARCH
COPY src/Campfire.Server/Front /front
RUN /front/install-thruster "$TARGETARCH" /out/thrust


FROM docker.io/library/debian:${DEBIAN_RELEASE}-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y ca-certificates && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Image metadata
ARG OCI_DESCRIPTION
LABEL org.opencontainers.image.description="${OCI_DESCRIPTION}"
ARG OCI_SOURCE
LABEL org.opencontainers.image.source="${OCI_SOURCE}"
LABEL org.opencontainers.image.licenses="MIT"

RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash

COPY --from=build /out/app /app
RUN ln -s /app/campfire /usr/local/bin/campfire
COPY --from=thruster /out/thrust /usr/local/bin/thrust

WORKDIR /rails

COPY --chmod=755 <<'EOF' /rails/bin/boot
#!/bin/sh
exec /usr/local/bin/thrust /usr/local/bin/campfire server
EOF

RUN ln -s /app/assets/public /rails/public

RUN mkdir -p /rails/storage/db /rails/storage/files /rails/storage/backups /rails/tmp && \
    chown -R 1000:1000 /rails

COPY --chmod=755 <<'EOF' /hooks/pre-backup
#!/bin/bash
cd /rails
exec /usr/local/bin/campfire backup
EOF
COPY --chmod=755 reference/hooks/post-restore /hooks/post-restore

USER 1000:1000

ENV RAILS_ENV="production" \
    CAMPFIRE_ASSETS_PATH="/app/assets" \
    DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV HTTP_IDLE_TIMEOUT=60
ENV HTTP_READ_TIMEOUT=300
ENV HTTP_WRITE_TIMEOUT=300

ARG APP_VERSION
ENV APP_VERSION=$APP_VERSION
ARG GIT_REVISION
ENV GIT_REVISION=$GIT_REVISION

EXPOSE 80 443

CMD ["bin/boot"]