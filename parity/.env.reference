# Fixed environment for the reference (Rails) container and for the Rust app under test.
# These are test-only keys: golden vectors, seeds and screenshots depend on them staying fixed.
RAILS_ENV=production
SECRET_KEY_BASE=5335c3b1ad35b4ad170c3413bd651ef3b6ed64e257261871a6de3f978cf3868ee417a927040935fb30b0f7debdedb34a2a403e9f34b16cf594c917c2ecd4a995
VAPID_PUBLIC_KEY=BEYXTBB5_jNhNzXDmx5KEU55Vbbd-u--Lk9rM5OFQvUkPIBwZJ9QzAq0zdEzFw6yTV8cTriz_qYBVicY02_VxTQ=
VAPID_PRIVATE_KEY=qfXLHghuG1rSHZUVo9SscNRI-0EIHRbIrfeGCqbAwak=
# config/environments/production.rb: assume_ssl/force_ssl are on unless DISABLE_SSL is present.
# Thruster only terminates TLS when TLS_DOMAIN is set, so leaving it unset serves plain HTTP.
DISABLE_SSL=true
# config/initializers/sentry.rb: no telemetry from parity runs.
SKIP_TELEMETRY=true
# config/initializers/version.rb: pins X-Version and the version badge.
APP_VERSION=parity
GIT_REVISION=parity
# config/puma.rb: fixed worker/thread counts so behavior doesn't vary with the host's CPU count.
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1
RAILS_LOG_LEVEL=info
