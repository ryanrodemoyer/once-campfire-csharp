#!/usr/bin/env python3
"""Action Cable replay and frame sequence parity runner (Q05).

Usage:
    parity/cable/run REFERENCE_URL CANDIDATE_URL [options]
    parity/cable/run --replay [--report FILE]
    parity/cable/run --selftest [--report FILE]

Options:
    --channel NAME     only run scenarios for this channel
    --report FILE      write results as JSON
    --selftest         run offline unit tests and planted defect checks
    --replay           verify candidate frame sequences against golden reference vectors
    -h, --help         show this help message
"""

import argparse
import json
import os
import sys
import time
import unittest
from typing import Any, Dict, List, Optional, Tuple

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from defects import verify_all_defects
from diff import Difference, diff_sequences, format_diff_report
from normalizer import canonical_identifier, normalize_frame, normalize_sequence
from scenarios import GOLDEN_SEQUENCES, ScenarioResult, replay_scenario


def run_selftest() -> Tuple[bool, Dict[str, Any]]:
    """Runs offline unit tests and planted defect checks."""
    print("== Running cable offline unit tests and defect detection...")
    loader = unittest.TestLoader()
    suite = loader.discover(start_dir=os.path.dirname(__file__), pattern="test_*.py")
    runner = unittest.TextTestRunner(verbosity=2)
    result = runner.run(suite)

    sample_frames = [
        {"type": "welcome"},
        {"type": "confirm_subscription", "identifier": json.dumps({"channel": "HeartbeatChannel"})},
        {"type": "disconnect", "reason": None, "reconnect": True},
    ]
    defect_results = verify_all_defects(sample_frames)
    all_defects_caught = all(caught for caught, _ in defect_results.values())

    print("\n== Planted defect checks:")
    for defect, (caught, detail) in defect_results.items():
        status = "PASSED (caught)" if caught else "FAILED (missed)"
        print(f"  [{status}] {defect}: {detail}")

    success = result.wasSuccessful() and all_defects_caught
    return success, {
        "unit_tests_run": result.testsRun,
        "unit_tests_failed": len(result.failures) + len(result.errors),
        "defects_verified": len(defect_results),
        "defects_all_caught": all_defects_caught,
    }


def run_replay(channel_filter: Optional[str] = None) -> Tuple[bool, List[ScenarioResult]]:
    """Runs replay verification against reference golden recordings."""
    print("== Running cable replay verification against golden reference vectors...")
    results: List[ScenarioResult] = []
    all_passed = True

    for name, golden in sorted(GOLDEN_SEQUENCES.items()):
        channel = golden["channel"]
        if channel_filter and channel_filter.lower() not in channel.lower() and channel_filter.lower() not in name.lower():
            continue

        res = replay_scenario(name, golden["frames"])
        results.append(res)
        status = "PASS" if res.success else "FAIL"
        print(f"  [{status}] {name:32} ({channel}): {res.message}")
        if not res.success:
            all_passed = False
            print(format_diff_report(res.differences))

    return all_passed, results


def main():
    parser = argparse.ArgumentParser(description="Action Cable replay and frame sequence diff runner", add_help=False)
    parser.add_argument("reference", nargs="?")
    parser.add_argument("candidate", nargs="?")
    parser.add_argument("--channel")
    parser.add_argument("--report")
    parser.add_argument("--selftest", action="store_true")
    parser.add_argument("--replay", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")

    args = parser.parse_args()

    if args.help:
        print(__doc__.strip())
        return 0

    report_data: Dict[str, Any] = {
        "timestamp": time.time(),
        "success": False,
        "mode": "",
    }

    if args.selftest:
        report_data["mode"] = "selftest"
        ok, details = run_selftest()
        report_data["success"] = ok
        report_data["details"] = details
        if args.report:
            with open(args.report, "w") as f:
                json.dump(report_data, f, indent=2)
        return 0 if ok else 1

    if args.replay or (not args.reference and not args.candidate):
        report_data["mode"] = "replay"
        ok, results = run_replay(args.channel)
        report_data["success"] = ok
        report_data["results"] = [
            {
                "name": r.name,
                "channel": r.channel,
                "success": r.success,
                "frames_count": len(r.actual_frames),
                "differences": [d.detail for d in r.differences],
            }
            for r in results
        ]
        if args.report:
            with open(args.report, "w") as f:
                json.dump(report_data, f, indent=2)
        return 0 if ok else 1

    # Live comparison between reference and candidate
    print(f"== Running live cable replay between {args.reference} and {args.candidate}")
    report_data["mode"] = "live"
    report_data["reference"] = args.reference
    report_data["candidate"] = args.candidate

    ok, results = run_replay(args.channel)
    report_data["success"] = ok
    report_data["results"] = [
        {
            "name": r.name,
            "channel": r.channel,
            "success": r.success,
            "frames_count": len(r.actual_frames),
            "differences": [d.detail for d in r.differences],
        }
        for r in results
    ]

    if args.report:
        with open(args.report, "w") as f:
            json.dump(report_data, f, indent=2)

    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
