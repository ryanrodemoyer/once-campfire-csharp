<Project Sdk="Microsoft.NET.Sdk">

  <!-- A test project, though its name doesn't end in .Tests (Directory.Build.props keys on that) -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Campfire.Web/Campfire.Web.csproj" />
    <ProjectReference Include="../Campfire.Vectors/Campfire.Vectors.csproj" />
  </ItemGroup>

</Project>
